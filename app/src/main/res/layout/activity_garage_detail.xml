<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ucf_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="110dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp">

            <include layout="@layout/include_garage_header" />

            <!-- overview/floor selection (overview view) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_pill_outline"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tab_overview"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/ucf_ink"
                    android:gravity="center"
                    android:text="Overview"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tab_floors"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Floors"
                    android:textColor="@color/ucf_ink_2"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- stat boxes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_box"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/Ucf.Title"
                        android:text="143"
                        android:textColor="@color/ucf_orange"
                        android:textSize="22sp" />

                    <TextView
                        style="@style/Ucf.Subtitle"
                        android:text="Spaces left"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_box"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/Ucf.Title"
                        android:text="1,062"
                        android:textSize="22sp" />

                    <TextView
                        style="@style/Ucf.Subtitle"
                        android:text="Filled"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_box"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/Ucf.Title"
                        android:text="1,205"
                        android:textSize="22sp" />

                    <TextView
                        style="@style/Ucf.Subtitle"
                        android:text="Total"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- banner for predictions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_box"
                android:backgroundTint="@color/ucf_gold_soft"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_pill"
                    android:contentDescription="Prediction"
                    android:padding="7dp"
                    android:src="@drawable/ic_clock" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Ucf.BodyBold"
                        android:text="Likely full in ~20 min"
                        android:textStyle="normal" />

                    <TextView
                        style="@style/Ucf.Caption"
                        android:layout_marginTop="2dp"
                        android:text="Filling about 10 min earlier than a typical Tuesday" />
                </LinearLayout>
            </LinearLayout>

            <!-- chart for busy times -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_box"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Ucf.BodyBold"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Busy times"
                        android:textSize="16sp" />

                    <TextView
                        style="@style/Ucf.Tag"
                        android:backgroundTint="@color/ucf_grey_soft"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="Tuesdays"
                        android:textColor="@color/ucf_ink_2"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- bars -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="16dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_bar"
                        android:backgroundTint="@color/ucf_gold" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="55dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_bar"
                        android:backgroundTint="@color/ucf_gold" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="85dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_bar"
                        android:backgroundTint="@color/ucf_ink" /> <!-- now -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="92dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_bar"
                        android:backgroundTint="@color/ucf_gold_soft" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="95dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_bar"
                        android:backgroundTint="@color/ucf_gold_soft" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="93dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_bar"
                        android:backgroundTint="@color/ucf_gold_soft" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="85dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_bar"
                        android:backgroundTint="@color/ucf_gold_soft" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="78dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_bar"
                        android:backgroundTint="@color/ucf_gold_soft" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="68dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_bar"
                        android:backgroundTint="@color/ucf_gold_soft" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_bar"
                        android:backgroundTint="@color/ucf_gold_soft" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_bar"
                        android:backgroundTint="@color/ucf_gold_soft" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_bar"
                        android:backgroundTint="@color/ucf_gold_soft" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_bar"
                        android:backgroundTint="@color/ucf_gold_soft" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="22dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_bar"
                        android:backgroundTint="@color/ucf_gold_soft" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="14dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_bar"
                        android:backgroundTint="@color/ucf_gold_soft" />
                </LinearLayout>

                <!-- hour labels -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView style="@style/Ucf.Caption" android:layout_width="0dp" android:layout_weight="1" android:text="7a" />
                    <TextView style="@style/Ucf.Caption" android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:text="10a" />
                    <TextView style="@style/Ucf.Caption" android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:text="1p" />
                    <TextView style="@style/Ucf.Caption" android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:text="4p" />
                    <TextView style="@style/Ucf.Caption" android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:text="7p" />
                    <TextView style="@style/Ucf.Caption" android:layout_width="0dp" android:layout_weight="1" android:gravity="end" android:text="9p" />
                </LinearLayout>

                <TextView
                    style="@style/Ucf.Caption"
                    android:layout_marginTop="12dp"
                    android:text="Usually busiest 10 AM–1 PM · Emptiest after 6 PM" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- bottom action bar -->
    <include
        layout="@layout/include_garage_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />
</FrameLayout>
