<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ucf_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- map preview with test notification -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="32dp">

        <!--map card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_box"
            android:clipToOutline="true">

            <include layout="@layout/include_campus_map" />
        </FrameLayout>

        <!-- notification bubble -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_box"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/ucf_red_soft"
                android:contentDescription="Alert"
                android:padding="5dp"
                android:src="@drawable/ic_bell"
                android:tint="@color/ucf_red" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Ucf.BodyBold"
                    android:text="Garage C is full"
                    android:textSize="12sp" />

                <TextView
                    style="@style/Ucf.Caption"
                    android:text="Just now"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <TextView
        style="@style/Ucf.Title"
        android:layout_marginTop="36dp"
        android:text="UCF Parking"
        android:textSize="36sp" />

    <TextView
        style="@style/Ucf.Subtitle"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Live garage status, fill-time warnings, and tips\nfrom fellow Knights." />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/btn_login"
        style="@style/Ucf.Button"
        android:text="Log in with UCF email" />

    <TextView
        style="@style/Ucf.Caption"
        android:layout_marginTop="10dp"
        android:text="For UCF students, faculty &amp; staff" />
</LinearLayout>