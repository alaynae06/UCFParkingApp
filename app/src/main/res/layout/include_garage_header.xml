<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_pill_outline"
            android:contentDescription="Back"
            android:padding="11dp"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Ucf.BodyBold"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Garage details"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/btn_more"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_pill_outline"
            android:contentDescription="More options"
            android:padding="11dp"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <!-- garage summary card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_box"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Ucf.Tag"
                android:layout_marginStart="0dp"
                android:backgroundTint="@color/ucf_orange_soft"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="● Filling fast"
                android:textColor="@color/ucf_orange"
                android:textSize="11sp" />

            <TextView
                style="@style/Ucf.Title"
                android:layout_marginTop="8dp"
                android:text="Garage B"
                android:textSize="28sp" />

            <TextView
                style="@style/Ucf.Subtitle"
                android:layout_marginTop="4dp"
                android:text="Faculty · Commuter · Resident · 0.3 mi"
                android:textSize="12sp" />

            <TextView
                style="@style/Ucf.Subtitle"
                android:layout_marginTop="6dp"
                android:text="Permit needed Mon–Fri, 7:30am–5:30pm"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- capacity ring -->
        <FrameLayout
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginStart="12dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/ring_capacity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="false"
                android:progress="88"
                app:indicatorColor="@color/ucf_orange"
                app:indicatorInset="0dp"
                app:indicatorSize="100dp"
                app:trackColor="@color/ucf_orange_soft"
                app:trackCornerRadius="6dp"
                app:trackThickness="10dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_ring_percent"
                    style="@style/Ucf.Title"
                    android:text="88%"
                    android:textSize="22sp" />

                <TextView
                    style="@style/Ucf.Caption"
                    android:text="full" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
