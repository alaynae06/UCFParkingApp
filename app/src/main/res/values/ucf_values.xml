<?xml version="1.0" encoding="utf-8"?>
<!-- ucf_values: all colors and text/button styles for the UCF Parking UI -->
<resources>
    <style name="Ucf" />   <!-- empty parent so the "Ucf.___" style names work -->

    <!-- ===== COLORS ===== -->
    <color name="ucf_bg">#F7F5EF</color>      <!-- cream screen background -->
    <color name="ucf_ink">#141414</color>     <!-- near-black: titles, buttons -->
    <color name="ucf_ink_2">#6B6A65</color>   <!-- grey: subtitles, captions -->
    <color name="ucf_ink_3">#A3A19A</color>   <!-- light grey: hint text -->
    <color name="ucf_line">#E8E4D9</color>    <!-- thin border color -->
    <color name="ucf_track">#E6E3DA</color>   <!-- empty part of progress bars -->
    <color name="ucf_gold">#E9B824</color>    <!-- UCF gold -->
    <color name="ucf_gold_soft">#FCF0C8</color> <!-- pale gold: banners, active nav tab -->
    <color name="ucf_grey">#7D7C77</color>    <!-- Resident permit / "blocked" -->
    <color name="ucf_grey_soft">#EEEDE8</color>
    <color name="ucf_red">#D9483B</color>     <!-- "Full" / "Closed" -->
    <color name="ucf_red_soft">#FBE4E1</color>
    <color name="ucf_orange">#E8892A</color>  <!-- "Filling fast" -->
    <color name="ucf_orange_soft">#FCEBD7</color>
    <color name="ucf_green">#2E9E5B</color>   <!-- "Open" -->
    <color name="ucf_green_soft">#E2F3E8</color>
    <color name="ucf_scrim">#66000000</color> <!-- see-through black over the map -->

    <!-- ===== TEXT STYLES ===== -->
    <style name="Ucf.Title">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ucf_ink</item>
        <item name="android:textSize">26sp</item>
    </style>
    <style name="Ucf.Subtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ucf_ink_2</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="Ucf.BodyBold">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ucf_ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Ucf.Caption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ucf_ink_2</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="Ucf.Label">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ucf_ink_2</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- ===== COMPONENT STYLES ===== -->
    <!-- Black pill button -->
    <style name="Ucf.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:backgroundTint">@color/ucf_ink</item>
    </style>
    <!-- Text input box -->
    <style name="Ucf.Input">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@drawable/bg_box</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:textColor">@color/ucf_ink</item>
        <item name="android:textColorHint">@color/ucf_ink_3</item>
        <item name="android:textSize">14sp</item>
    </style>
    <!-- Filter chip on the map ("Commuter", "Resident"...) -->
    <style name="Ucf.Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:elevation">2dp</item>
        <item name="android:textColor">@color/ucf_ink</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!-- Small colored status tag ("Filling fast", "Open"); set backgroundTint + textColor per use -->
    <style name="Ucf.Tag">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:paddingVertical">2dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>